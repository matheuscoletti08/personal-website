---
import { locales, defaultLocale } from '../i18n';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const fallback = defaultLocale;
---

<meta http-equiv="refresh" content={`0; url=${base}${fallback}/`} />
<script define:vars={{ base, locales, fallback }}>
	const lang = (navigator.language ?? '').toLowerCase();
	const matched = locales.find((l) => lang.startsWith(l));
	window.location.replace(`${base}${matched ?? fallback}/`);
</script>
